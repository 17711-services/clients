{
  "name": "@xyz17711/catalog",
  "version": "0.1.2",
  "description": "Typed TypeScript client for the 17711.xyz Catalog API: pay-per-call, settled in USDC via x402.",
  "license": "MIT",
  "author": "17711 Services",
  "homepage": "https://api.17711.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/17711-services/clients.git",
    "directory": "node/packages/catalog"
  },
  "bugs": {
    "url": "https://github.com/17711-services/clients/issues"
  },
  "keywords": [
    "x402",
    "usdc",
    "api-client",
    "pay-per-call",
    "ai-agents",
    "mcp",
    "langchain",
    "catalog"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "default": "./dist/langchain.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@xyz17711/core": "^0.1.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3",
    "zod": "^3 || ^4"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5",
    "@langchain/core": "^1.2",
    "zod": "^4"
  }
}
